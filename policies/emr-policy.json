{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3ReadData",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::[BUCKET_NAME]",
                "arn:aws:s3:::[BUCKET_NAME]/data/*",
                "arn:aws:s3:::[BUCKET_NAME]/scripts/*"
            ]
        },
        {
            "Sid": "S3WriteOutput",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::[BUCKET_NAME]/output/*"
            ]
        },
        {
            "Sid": "CloudWatchLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:[REGION]:[ACCOUNT_ID]:*"
        }
    ]
}